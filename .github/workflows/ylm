name: Build TalkLikeMe APK

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract and Auto-Fix Android Project
        run: |
          shopt -s nullglob
          zips=(*.zip)
          if [ ${#zips[@]} -gt 0 ]; then
            unzip -o "${zips[0]}"
          else
            echo "ERROR: Please upload TalkLikeMe_APK_Package.zip to the Code tab first!"
            exit 1
          fi
          # Remove legacy package attribute so Android Gradle 8.1+ succeeds
          sed -i 's/package="com.talklikeme.app"//g' android_native_project/app/src/main/AndroidManifest.xml

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: '8.2'

      - name: Build Debug APK
        working-directory: ./android_native_project
        run: gradle assembleDebug --no-daemon

      - name: Upload Compiled APK
        uses: actions/upload-artifact@v4
        with:
          name: TalkLikeMe-Android-APK
          path: android_native_project/app/build/outputs/apk/debug/app-debug.apk
